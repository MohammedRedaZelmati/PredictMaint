# Copy to .env (git-ignored) and adjust. Never commit real secrets.
POSTGRES_DB=smartpredict
POSTGRES_USER=smartpredict
POSTGRES_PASSWORD=change-me-locally
# Host port for PostgreSQL. 5432 is often occupied by a local PostgreSQL on Windows.
POSTGRES_HOST_PORT=5432

# Spark worker sizing: 2 cores / 1 GiB each so archive and inference (2 x 450m executors each,
# one per worker) run at the same time.
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1g

# Model version served by the hot path (lot A5).
MODEL_VERSION=v001
